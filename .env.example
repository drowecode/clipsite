# Public URL of the deployed site (used for absolute links in Discord embeds)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Cloudflare R2 (S3-compatible). Create an API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=snip-clips

# Public base URL for the bucket: the r2.dev URL or a custom domain, no trailing slash
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
